{
  "permissions": {
    "additionalDirectories": [
      "../ZubuvZpevnik",
      "../chords_converter"
    ],
    "allow": [
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ninja *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git -C ../ZubuvZpevnik status *)",
      "Bash(git -C ../ZubuvZpevnik diff *)",
      "Bash(git -C ../ZubuvZpevnik log *)",
      "Bash(git -C ../chords_converter status *)",
      "Bash(git -C ../chords_converter diff *)",
      "Bash(git -C ../chords_converter log *)",
      "Bash(lualatex *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(pdftoppm *)",
      "Bash(../ZubuvZpevnik/scripts/checksongs.py *)",
      "Bash(../ZubuvZpevnik/scripts/checkkeys.py *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git -C ../ZubuvZpevnik push *)",
      "Bash(git -C ../chords_converter push *)",
      "Bash(rm -rf ../*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-cpp.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
