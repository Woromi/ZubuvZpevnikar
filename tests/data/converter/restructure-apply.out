\beginsong{Restructure}[by={Test}, key=C, lang=czech]

\beginverse
\[C]Ráno vstanu, \[G]půjdu ven,
\[Am]bude zase \[F]krásný den.
\endverse

\beginchorus
\[F]Zpívej se mnou, \[C]zpívej dál,
\[G]ať to slyší \[C]celý sál.
\endchorus

\beginverse
\[C]Večer ulehnu \[G]do peřin,
\[Am]zdá se mi, že \[F]nejsem sám.
\endverse

\beginchorus
\[G]Zpívej se mnou, \[D]zpívej dál,
\[A]ať to slyší \[D]celý sál.
\endchorus
\endsong
